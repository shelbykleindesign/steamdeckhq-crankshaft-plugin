{
  "name": "tilt-kart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "First-person iPad kart racer. Turn the iPad to steer; the horizon stays level. Online 2-player with a pairing code. Live at moto.shelbyklein.com.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "test": "node --test test/*.test.mjs",
    "track": "node tools/track-report.mjs",
    "peer-server": "peerjs --port 9000 --host 0.0.0.0",
    "test:e2e": "node test/e2e/tilt.mjs && node test/e2e/online.mjs",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.mjs\" \"tools/*.mjs\" build.mjs docs/style.css docs/index.html"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "peer": "^1.0.2",
    "playwright": "^1.56.1"
  }
}
